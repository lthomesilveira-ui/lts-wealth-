{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lts-projection-reference-v412",
  "type": "object",
  "required": [
    "schema_version",
    "revision",
    "updated_on",
    "series"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_on": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "series_key",
          "window_from",
          "window_to",
          "coverage_months",
          "sum_brl",
          "mean_brl",
          "source_refs",
          "raw_hashes"
        ],
        "properties": {
          "series_key": {
            "type": "string",
            "minLength": 1
          },
          "window_from": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
          },
          "window_to": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
          },
          "coverage_months": {
            "const": 12
          },
          "sum_brl": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              }
            ]
          },
          "mean_brl": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
              }
            ]
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "raw_hashes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
